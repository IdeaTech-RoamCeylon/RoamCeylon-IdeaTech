{
  "expo": {
    "name": "RoamCeylon Admin",
    "slug": "RoamCeylonAdmin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Icon.png",
    "scheme": "roamceylonadmin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/Icon.png",
      "bundleIdentifier": "com.ideatech.roamceylonadmin"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5FDEB",
        "foregroundImage": "./src/assets/Icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.ideatech.roamceylonadmin"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/Icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/Icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B3D1F"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@rnmapbox/maps",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e31769d8-9d06-4344-a2fb-17de02db76c6"
      }
    }
  }
}
